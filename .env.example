# Renomeie este arquivo para .env e adicione suas chaves de API reais

# Tipo do modelo de IA (Pode ser 'anthropic' ou 'gemini')
AI_MODEL_TYPE=anthropic

# Chaves de API
ANTHROPIC_API_KEY=sua_chave_api_comeca_com_sk-ant-...
GEMINI_API_KEY=sua_chave_api_do_google_ai_studio

# Configurações do Banco de Dados Vetorial (Postgres)
USE_DOCKER=True
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus_ia
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres
